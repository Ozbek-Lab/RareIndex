10.100.12.79:443 {
    # Local HTTPS using Caddy's internal
    tls internal

    # Serve collected static files (STATIC_URL=/static/, STATIC_ROOT=/app/staticfiles)
    handle_path /static/* {
        root * /app/staticfiles
        file_server
    }

    # Browser-facing Marimo apps. Marimo is started with matching --base-url values.
    handle /marimo-run* {
        reverse_proxy marimo-run:8091
    }

    handle /marimo-edit* {
        reverse_proxy marimo-edit:8092
    }

    # Reverse proxy Django app
    handle {
        reverse_proxy web:8090 {
            header_up X-Forwarded-Proto {scheme}
            header_up Host rare
        }
    }
}
